# Copy this file to .env and fill in your own values. Never commit .env.

# Which LLM backend to use: groq | google | ollama
LLM_PROVIDER=groq

# Model name for that provider. Model names change often; check the provider's
# current model list (console.groq.com/docs/models, ai.google.dev/models, `ollama list`).
LLM_MODEL=openai/gpt-oss-120b

# Reasoning effort for reasoning models such as gpt-oss / qwen (low | medium | high).
# "low" keeps answers fast and inside free-tier tokens-per-minute limits.
LLM_REASONING_EFFORT=low

# API keys (only the one for your provider is needed)
GROQ_API_KEY=
GOOGLE_API_KEY=

# Per-provider models, used when you switch provider in the app.
# LLM_MODEL above is the model for LLM_PROVIDER; these override it per provider.
GROQ_MODEL=
# Free tier note (Nov 2026): gemini-3.5-flash allows only 20 requests/day; the lite model has its own, larger quota.
GOOGLE_MODEL=gemini-3.5-flash-lite

# Ollama: set OLLAMA_API_KEY to use Ollama's cloud (https://ollama.com); leave it empty for a local Ollama.
# Cloud keys look like <id>.<secret>; copy the whole key.
OLLAMA_API_KEY=
OLLAMA_BASE_URL=
OLLAMA_MODEL=gpt-oss:120b

# Seconds before an LLM request is abandoned
LLM_TIMEOUT_SECONDS=60

# Local embedding model (runs on your machine, downloaded once)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Where ChromaDB stores its files
CHROMA_DIR=chroma_db
